{
  "name": "translate-projects-astro",
  "version": "0.0.1",
  "description": "Translate the i18n JSON files of your Astro site with Translate Projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "rm -rf dist",
    "test": "npm run build && node --test 'test/*.test.js'",
    "prepublishOnly": "npm test",
    "lint": "eslint",
    "format": "prettier --write .",
    "lint:fix": "eslint --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "astro",
    "astro i18n",
    "i18next",
    "translate projects",
    "translate projects astro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/translate-projects/translate-projects-astro.git"
  },
  "bugs": {
    "url": "https://github.com/translate-projects/translate-projects-astro/issues"
  },
  "author": {
    "name": "Neider Ruiz",
    "email": "neiderbtc@gmail.com",
    "url": "http://github.com/neiderruiz/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "translate-projects-core": "^0.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.4.5",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  },
  "homepage": "https://doc.translateprojects.dev/docs/frameworks-javascript/astro"
}
