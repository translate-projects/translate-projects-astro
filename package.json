{
  "name": "translate-project",
  "version": "0.0.1",
  "description": "Internationalize and manage your website easily",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils/index.js",
    "./types": "./dist/utils/index.js"
  },
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/utils/index.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "jest",
    "build:babel": "babel src --out-dir dist --extensions '.ts,.tsx,.js,.jsx'",
    "build:react": "tsc",
    "build": "npm run build:react && npm run build:babel",
    "start": "node dist/index.js",
    "prebuild": "rm -rf dist",
    "lint": "eslint",
    "format": "prettier --write .",
    "lint:fix": "eslint --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "translate project",
    "translate projects",
    "files",
    "translate-files",
    "translate-file",
    "translate-file-csv",
    "nextjs translate project",
    "astro translate project",
    "docusaurus translate project"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/neiderruiz/translate-files.git"
  },
  "bugs": {
    "url": "http://github.com/neiderruiz/translate-files/issues"
  },
  "author": {
    "name": "Neider Ruiz",
    "email": "neiderbtc@gmail.com",
    "url": "http://github.com/neiderruiz/"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-typescript": "^7.23.2",
    "@types/node": "^20.4.5",
    "@types/react": "^18.2.56",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@types/chokidar": "^2.1.7",
    "@types/eventsource": "^1.1.15",
    "@types/i18next": "^13.0.0",
    "chokidar": "^4.0.3",
    "csvtojson": "^2.0.10",
    "eventsource": "^2.0.2",
    "react-i18next": "^13.5.0",
    "translate-projects-core": "file:../core"
  }
}